APP_NAME="Ruang Dengar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Use the exact credentials from InfinityFree, never the local database.
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=

# Database-backed sessions/cache are supported without Redis or a worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# An external authorized SMTP sender is required for password recovery.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=CHANGE_ME@example.com
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_COOLDOWN_SECONDS=900
SECURITY_REPEAT_THRESHOLD=5
SECURITY_REPEAT_WINDOW_SECONDS=600
SANCTUM_TOKEN_TTL_MINUTES=480
