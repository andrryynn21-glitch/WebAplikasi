APP_NAME="Ruang Dengar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.alwaysdata.net
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Create a new database and a dedicated user in the alwaysdata dashboard.
# Never import local accounts, tokens, KTM files, or reports.
DB_CONNECTION=mysql
DB_HOST=mysql-CHANGE_ME.alwaysdata.net
DB_PORT=3306
DB_DATABASE=CHANGE_ME_ruangdengar
DB_USERNAME=CHANGE_ME_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
FILESYSTEM_DISK=local

# Free hosting has no persistent background workers; current actions are synchronous.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Set a real, authorized SMTP sender before enabling password recovery.
# Never use the log mailer to obtain reset links.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp-CHANGE_ME.alwaysdata.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=CHANGE_ME@example.com
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_COOLDOWN_SECONDS=900
SECURITY_REPEAT_THRESHOLD=5
SECURITY_REPEAT_WINDOW_SECONDS=600
SANCTUM_TOKEN_TTL_MINUTES=480
